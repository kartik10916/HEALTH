# Server & Security Configuration
SECRET_KEY=supersecret-healthcare-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection
DATABASE_URL=sqlite:///./healthcare.db

# AI Triage Service (Gemini API Key - Optional, falls back to Rule Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Configuration for Email Reminders (Optional, falls back to Mock Console Logging)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@healthplatform.com
SMTP_PASS=your_email_password

# Google OAuth Configuration (Optional, enables Google Sign-In button integration)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

